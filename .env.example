# Versión de Python para crear el entorno virtual (.venv) con make up / setup. Por defecto 3.12.
# PYTHON_VERSION=3.12

# Opcional: URL de Ollama (por defecto http://localhost:11434)
# OLLAMA_HOST=http://localhost:11434

# Opcional: ruta de la base de datos SQLite
# DATABASE_URL=sqlite:///./chatbot.db

# Número de pares (user+assistant) de historial a enviar a Ollama. Por defecto 10.
# OLLAMA_HISTORY_TURNS=10

# RAG con ChromaDB: embeddings con Ollama por defecto (ver RAG_CHROMADB_CHECKLIST.md)
# CHROMA_HOST por defecto es http://localhost:8001
# CHROMA_HOST=http://localhost:8001
# Modelo de embeddings en Ollama (por defecto mxbai-embed-large:latest). Haz: ollama pull mxbai-embed-large
# OLLAMA_EMBEDDING_MODEL=mxbai-embed-large:latest
# Opcional: usar OpenAI para embeddings (poner key en .env, no subir a git). Si cambias de proveedor, haz make chroma-clean y make chroma-up.
# EMBEDDINGS_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com
# Opcional: organización y proyecto (el uso se atribuye al proyecto). Ver https://developers.openai.com/api/reference/overview/
# OPENAI_ORGANIZATION_ID=org-...
# OPENAI_PROJECT_ID=proj_...

# Multi-provider LLM: Mancer (https://mancer.tech)
# MANCER_API_KEY=mcr-...
# DEFAULT_LLM_PROVIDER=ollama  # ollama | mancer | openai | abliteration | nan

# abliteration.ai (https://docs.abliteration.ai/) — API key ak_... desde la consola
# ABLIT_KEY=ak_...
# ABLIT_BASE_URL=https://api.abliteration.ai

# NaN Builders (https://nan.builders/docs) — API compatible con OpenAI, key sk-...
# Requiere ser miembro de la comunidad NaN. Algunos modelos (glm5.3) necesitan tier premium.
# NAN_API_KEY=sk-...
# NAN_BASE_URL=https://api.nan.builders

# Forge Neo (ilustración de relatos) — ReplayLastGeneration
# FORGE_BASE_URL=http://127.0.0.1:7860
# FORGE_DATA_PATH=/home/pacogarat/Applications/Data
# Opcional: refs img2img con prioridad sobre la última salida
# FORGE_STYLE_INIT_DIR=/home/pacogarat/Applications/Data/chatbot-style-init
# FORGE_TIMEOUT_SECONDS=600

# ReActor (face swap post-generación; requiere extensión ReActor en Forge)
# Imagen fuente cuando no usas facemodels Mujer/Hombre en el panel
# FORGE_REACTOR_SOURCE_IMAGE=/ruta/a/cara-fuente.jpg
# Modelo InsightFace para el swap
# FORGE_REACTOR_MODEL=inswapper_128.onnx
# Índices de caras (separados por coma)
# FORGE_REACTOR_SOURCE_FACES_INDEX=0
# FORGE_REACTOR_FACE_INDEX=0
# Upscale tras el swap (None = desactivado)
# FORGE_REACTOR_UPSCALER=None
# FORGE_REACTOR_SCALE=1
# FORGE_REACTOR_UPSCALE_VISIBILITY=1
# Restaurador facial (CodeFormer, GFPGAN, None)
# FORGE_REACTOR_FACE_RESTORER=CodeFormer
# FORGE_REACTOR_RESTORER_VISIBILITY=1
# FORGE_REACTOR_CODEFORMER_WEIGHT=0.5
# FORGE_REACTOR_RESTORE_FIRST=1
# Detección de género: 0=any, 1=mujer, 2=hombre (modo imagen fuente)
# FORGE_REACTOR_GENDER_SOURCE=0
# FORGE_REACTOR_GENDER_TARGET=0
# Dispositivo de inferencia ReActor
# FORGE_REACTOR_DEVICE=CUDA
# 1=máscara facial, 0=bbox
# FORGE_REACTOR_MASK_FACE=1
# Origen fuente: 0=imagen, 1=facemodel, 2=carpeta
# FORGE_REACTOR_SELECT_SOURCE=0
# Facemodel genérico (models/reactor/faces) si select_source=1
# FORGE_REACTOR_FACE_MODEL=
# Carpeta de imágenes fuente si select_source=2
# FORGE_REACTOR_SOURCE_FOLDER=
# 1=imagen aleatoria de source_folder
# FORGE_REACTOR_RANDOM_IMAGE=0
# 1=upscale aunque no detecte cara
# FORGE_REACTOR_UPSCALE_FORCE=0

# OPENAI_PROJECT_ID=proj_tNspeLCQsFMCAYDUL7alSXJk
